{
  "basic": {
    "description": "基础",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用插件",
        "type": "bool",
        "default": true,
        "hint": "总开关；关闭后停止采集、/画像 与 LLM 工具都不再响应"
      },
      "public_query": {
        "description": "公开查询",
        "type": "bool",
        "default": true,
        "hint": "开启后任何人都能用 /画像 查别人；关闭则仅管理员可用"
      },
      "show_avatar": {
        "description": "回复带头像",
        "type": "bool",
        "default": true,
        "hint": "/画像 回复里附上对方 QQ 头像；非 QQ 平台发不出来会自动回退纯文本"
      }
    }
  },
  "collect": {
    "description": "数据采集",
    "type": "object",
    "items": {
      "passive_collect": {
        "description": "被动采集发言",
        "type": "bool",
        "default": true,
        "hint": "静默统计每个 QQ 的发言数与原话；关闭后不再采集，已有数据保留"
      },
      "collect_private": {
        "description": "采集私聊",
        "type": "bool",
        "default": true,
        "hint": "是否统计私聊发言；在意隐私可关掉，只留群聊"
      },
      "collect_groups": {
        "description": "采集群列表",
        "type": "string",
        "default": "",
        "hint": "只采集这些群，逗号分隔群号；留空采集全部群"
      },
      "quote_keep": {
        "description": "原话保留条数",
        "type": "int",
        "default": 10,
        "hint": "每个 QQ 保留最近多少条发言原话"
      },
      "max_tracked_users": {
        "description": "最多跟踪人数",
        "type": "int",
        "default": 5000,
        "hint": "超过后自动清掉最不活跃的用户，防数据无限涨"
      },
      "flush_interval": {
        "description": "落盘间隔（秒）",
        "type": "int",
        "default": 60,
        "hint": "采集数据先攒在内存，每隔这么久批量写入一次磁盘"
      }
    }
  },
  "tags": {
    "description": "标签生成",
    "type": "object",
    "items": {
      "llm_tags": {
        "description": "LLM 语义标签",
        "type": "bool",
        "default": true,
        "hint": "由 LLM 根据最近原话自动打 spam_suspect / ad_suspect / troll 等语义标签；发言数没变就用缓存"
      },
      "llm_provider_id": {
        "description": "标签用模型",
        "type": "string",
        "default": "",
        "hint": "生成 LLM 标签用的模型，留空用 AstrBot 默认模型"
      },
      "quote_show": {
        "description": "原话展示条数",
        "type": "int",
        "default": 5,
        "hint": "/画像 里展示最近几条发言摘录"
      },
      "history_fallback": {
        "description": "会话历史补充",
        "type": "bool",
        "default": true,
        "hint": "自己没采集到此人时，改用 AstrBot 会话历史搜 TA 的发言原话"
      },
      "tag_active_high_threshold": {
        "description": "高活跃阈值",
        "type": "int",
        "default": 100,
        "hint": "累计发言数达到多少打 active_high 标签"
      },
      "tag_active_med_threshold": {
        "description": "中活跃阈值",
        "type": "int",
        "default": 20,
        "hint": "累计发言数达到多少打 active_medium 标签"
      },
      "tag_newcomer_days": {
        "description": "新人判定天数",
        "type": "int",
        "default": 7,
        "hint": "首次记录在多少天内打 newcomer 标签"
      },
      "tag_multi_group_threshold": {
        "description": "多群判定阈值",
        "type": "int",
        "default": 3,
        "hint": "活跃群数达到多少打 multi_group 标签"
      }
    }
  },
  "link": {
    "description": "插件联动",
    "type": "object",
    "items": {
      "link_invite_guard": {
        "description": "联动邀请守卫",
        "type": "bool",
        "default": true,
        "hint": "读取加群邀请守卫的前科记录生成 ban_history / frequent_inviter 等标签；没装该插件自动跳过"
      },
      "link_qq_tools_ban": {
        "description": "联动黑名单",
        "type": "bool",
        "default": true,
        "hint": "读取 qq_tools 黑名单生成 ban_history 标签；没装自动跳过"
      }
    }
  }
}
